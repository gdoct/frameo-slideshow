# Copy to .env and adjust. .env is git-ignored; docker compose and deploy.sh read it.

# Address and port the service is published on (use your server's LAN IP to
# keep it off other interfaces, or 0.0.0.0 for all).
BIND_ADDR=0.0.0.0
PORT=8088

# Immich server as seen from inside the container (no trailing /api).
# If Immich runs on the same host, use the host's LAN IP, not localhost.
IMMICH_URL=http://192.168.1.10:2283
# Immich: Account settings > API keys. Needed permissions: album.read, asset.read, asset.view.
IMMICH_API_KEY=
# Album to show, by name (case-insensitive) or id.
IMMICH_ALBUM=Guido
# How often to re-read the album, in minutes.
REFRESH_MINUTES=60
# Set to 0 if IMMICH_URL is https with a self-signed certificate.
NODE_TLS_REJECT_UNAUTHORIZED=1

# deploy.sh: SSH host (name from ~/.ssh/config or user@host) and target directory there.
DEPLOY_HOST=myserver
DEPLOY_DIR=slideshow
